# Example configuration (docs/build-guide/06). Contains no credentials.
# Copy to .env only on a private host; never commit .env or secret files.
# Secrets are referenced through *_FILE paths (mounted, restricted permissions),
# never as inline values or command-line arguments.

MARKETAGG_ENV=development
PROVIDER=fake
# A boolean alone cannot enable live data: a non-fake provider also needs a
# recorded source review (SOURCE_REVIEW_ID) and, where applicable, credentials.
LIVE_DATA_ENABLED=false
SOURCE_REVIEW_ID=
PROVIDER_CREDENTIALS_FILE=

DATABASE_URL_FILE=/run/secrets/database_url
API_READ_TOKEN_FILE=/run/secrets/api_read_token
API_EXPORT_TOKEN_FILE=/run/secrets/api_export_token
API_BIND_HOST=127.0.0.1

UNIVERSE_CONFIG=config/universe.yaml
POLICY_CONFIG=config/policies.yaml

# Self-imposed pacing; NOT a documented provider limit.
REQUESTS_PER_MINUTE=10
PLANNED_UTILIZATION_LIMIT=0.70
PROVIDER_CONCURRENCY=1

HOT_RETENTION_DAYS=90
RAW_RETENTION_DAYS=30
MAX_LOCAL_DATA_GIB=100
MAX_EXPORT_ROWS=5000000

BACKUP_DESTINATION=
BACKUP_KEY_FILE=/run/secrets/backup_key

DATA_ROOT=data
ARCHIVE_OFFSITE=
API_PORT=8000

LOG_LEVEL=INFO
